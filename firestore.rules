rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 닉네임: 문자열 1~8자만 허용
    function validNickname(data) {
      return data.nickname is string
        && data.nickname.size() >= 1
        && data.nickname.size() <= 8;
    }

    // 사용자 문서: 본인(익명 uid)만 쓰기, 리더보드용 공개 읽기
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && validNickname(request.resource.data);
    }

    // 점수 로그: 본인 명의 생성만, 수정·삭제 불가, 값 범위 검증
    match /scores/{doc} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && validNickname(request.resource.data)
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score < 100000
        && request.resource.data.bananas is int
        && request.resource.data.bananas >= 0
        && request.resource.data.bananas <= 2000
        && (!('kinds' in request.resource.data)
          || (request.resource.data.kinds is int
            && request.resource.data.kinds >= 0
            && request.resource.data.kinds <= 18));
      allow update, delete: if false;
    }

    // 경품 응모 연락처(향후): 웹에서는 아무도 읽을 수 없음 — 콘솔에서만 열람
    match /contacts/{uid} {
      allow read: if false;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }
  }
}
